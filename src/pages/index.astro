					</li>
				))
			}
		</ul> -->
		<ul class="space-y-4 sm:space-y-2">
			<li>
				<p class="text-gray-500">Programming Languages</p>
				<p>Java 17, Python 3, Kotlin, TypeScript, JavaScript, SQL, Rust, Bash</p>
			</li>

			<li>
				<p class="text-gray-500">Frameworks</p>
				<ul class="ml-6 list-none">
					<li>
						<p class="text-gray-500">Backend</p>
						<p>Spring Boot, Spring MVC, Spring Cloud, Dropwizard, JPA, Hibernate</p>
					</li>
					<li>
						<p class="text-gray-500">Frontend</p>
						<p>ReactJS, AngularJS, Astro</p>
					</li>
				</ul>
			</li>

			<li>
				<p class="text-gray-500">Cloud Platforms</p>
				<p>Amazon Web Services (AWS), Google Cloud Platform (GCP)</p>
			</li>

			<li>
				<p class="text-gray-500">Databases</p>
				<p>PostgreSQL, MySQL, SQLite, DynamoDB, MongoDB</p>
			</li>
			<li>
				<p class="text-gray-500">Message Queues</p>
				<p>RabbitMQ, JMS, Kafka</p>
			</li>
			<li>
				<p class="text-gray-500">Cache</p>
				<p>Redis</p>
			</li>
			<li>
				<p class="text-gray-500">Other Tech</p>
				<p>Git, Linux, Docker, Jenkins, Maven, Gradle, Liquibase, HTML5, Tailwind CSS</p>
			</li>
		</ul>
	</section>
</PageLayout>
