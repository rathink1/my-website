---
import { Image } from "astro:assets";

import PageLayout from "@/layouts/Base";
import aboutImg from "@/assets/404-cat.avif";

const meta = {
	title: "Oops! You found a missing page!",
	description: "Oops! It looks like this page is lost in space!",
};
---

<PageLayout meta={meta}>
	<h1 class="title mb-6 grid justify-center">404 | OOPS something went wrong</h1>
	<p class="mb-8 grid justify-center">Please use the navigation to find your way back</p>
	<div class="my-4 grid justify-center" data-aos="fade-up">
		<div class="h-80 w-80 overflow-hidden rounded-full border border-gray-300">
			<Image
				class="rotate-180"
				src={aboutImg}
				alt="A cartoon cactus looking at the 'Astro.build' logo"
				loading="eager"
				style="pointer-events: none;"
			/>
		</div>
	</div>
</PageLayout>
