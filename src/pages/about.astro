---
import { Image } from "astro:assets";

import PageLayout from "@/layouts/Base";
import aboutImg from "@/assets/personal-pic.jpg";

const meta = {
	title: "About",
	description: "More about me.",
};
---

<PageLayout meta={meta}>
	<div class="space-y-6">
		<div class="flex justify-center">
			<div class="h-80 w-80 overflow-hidden rounded-full border border-black">
				<Image
					src={aboutImg}
					alt="Rathin's photo"
					loading="eager"
					fetchpriority="high"
					style="pointer-events: none;"
				/>
			</div>
		</div>
		<p class="title mb-4">Namaste 🙏🏼</p>
		<p data-aos="fade-up">
			I am a passionate explorer in the boundless realm of technology and creativity. I graduated
			from Indian Institute of Technology (IIT) Kharagpur, wiz a premier public university of India
			🇮🇳, in 2017 with my Bachelor of Technology degree.
		</p>
		<p data-aos="fade-up">
			Armed with a keyboard and an unyielding determination, right out of university, I dove into
			the depths of algorithms, sculpting them into seamless applications that bring ideas to life.
			While working in Bengaluru India, I developed microservices for client JP Morgan Chase Bank, a
			Fin-Tech Startup Kuliza, and most recently an E-commerce platform BazaarVoice.
		</p>
		<p data-aos="fade-up">This year I moved to Berlin, Germany 🇩🇪 and live here with my wife.</p>

		<p data-aos="fade-up">
			After work, I love participating in Hackathons, building hobby projects using Generative AI,
			travelling and learning German. I am also a licensed Paragliding Pilot, having flown in the
			Himalayas, Southern India and Poland. 🪂
		</p>

		<p data-aos="fade-up">
			If you are interested in working with me, feel free to hit me up on my socials!
		</p>
	</div>
</PageLayout>
